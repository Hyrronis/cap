# Copie ce fichier en .env.local pour activer Supabase.
# Sans ces deux variables, l'app tourne entièrement en local (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Côté serveur uniquement (suppression de compte). Jamais de préfixe NEXT_PUBLIC_.
# À définir dans Vercel (marquée « Sensitive »), pas dans un fichier commité.
SUPABASE_SECRET_KEY=
